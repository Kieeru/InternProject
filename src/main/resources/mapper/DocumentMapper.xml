<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xcy.internproject.repository.mybatis.mapper.DocumentMapper">

    <insert id="insert"
            parameterType="com.xcy.internproject.repository.mybatis.record.DocumentRecord"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO documents (title, content)
        VALUES (#{title}, #{content})
    </insert>

    <select id="findById"
            parameterType="java.lang.Long"
            resultType="com.xcy.internproject.repository.mybatis.record.DocumentRecord">
        SELECT id, title, content, created_at
        FROM documents
        WHERE id = #{id}
          AND deleted = 0
    </select>

    <update id="update">
        UPDATE documents
        SET title = #{title},
            content = #{content}
        WHERE id = #{id}
          AND deleted = 0
    </update>

    <select id="findPage"
            parameterType="com.xcy.internproject.repository.DocumentPageQuery"
            resultType="com.xcy.internproject.repository.mybatis.record.DocumentRecord">
        SELECT id, title, created_at
        FROM documents
        WHERE deleted = 0
        <if test="titlePrefix != null and titlePrefix != ''">
            AND title LIKE CONCAT(#{titlePrefix}, '%') ESCAPE '='
        </if>
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count"
            parameterType="com.xcy.internproject.repository.DocumentPageQuery"
            resultType="long">
        SELECT COUNT(*)
        FROM documents
        WHERE deleted = 0
        <if test="titlePrefix != null and titlePrefix != ''">
            AND title LIKE CONCAT(#{titlePrefix}, '%') ESCAPE '='
        </if>
    </select>

</mapper>
