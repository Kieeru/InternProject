<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xcy.internproject.repository.mybatis.mapper.UserMapper">

    <insert id="insert"
            parameterType="com.xcy.internproject.repository.mybatis.record.UserRecord"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO users (username, email)
        VALUES (#{username}, #{email})
    </insert>

    <select id="findById"
            parameterType="java.lang.Long"
            resultType="com.xcy.internproject.repository.mybatis.record.UserRecord">
        SELECT id, username, email
        FROM users
        WHERE id = #{id}
          AND deleted = 0
    </select>

</mapper>
